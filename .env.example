# ==============================================================================
# Shinobi (RepoVet MCP) - Environment Configuration Template
# Copy this file to .env and populate with your own preferences.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Server Environment & Logging
# Options: development, staging, production, testing
REPOVET_ENVIRONMENT=development
REPOVET_LOG_LEVEL=INFO

# GitHub API Credentials (Optional but strongly recommended)
# Used directly by Shinobi's internal GitHub REST client for deterministic
# evidence collection. Raises rate limits from 60 req/hr (unauthenticated)
# to 5,000 req/hr.
# Generate at: https://github.com/settings/tokens (classic token with public repo read access or fine-grained token)
REPOVET_GITHUB_TOKEN=ghp_your_github_personal_access_token_here
REPOVET_GITHUB_API_URL=https://api.github.com

# Configuration File Paths (relative to repository root or absolute)
REPOVET_SCORING_CONFIG_PATH=config/scoring.yaml
REPOVET_THRESHOLDS_CONFIG_PATH=config/thresholds.yaml

# Data & Output Directories
REPOVET_REPORTS_DIR=reports
REPOVET_DATA_DIR=data
REPOVET_LOGS_DIR=logs

# ==============================================================================
# Note on AI Orchestration & Credentials:
# Shinobi requires no separately billed LLM API keys or API usage.
# AI orchestration uses the user's independently authenticated AI client
# (such as Claude Code or Antigravity CLI) and existing subscription,
# subject to provider usage limits and terms.
#
# Shinobi exposes deterministic vetting tools over Model Context Protocol (stdio).
# If you also connect the official GitHub MCP server in your AI client,
# provide your GitHub token in that client's MCP configuration.
# ==============================================================================
